# Dependencies
node_modules/

# Environment & secrets
.env
.env.*
*.pem
*.key

# OS / editor
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Build artifacts
*.bak
*.log
npm-debug.log*

# Generated reports (embed pipeline output, session PDFs, intermediate markdown)
reports/embed-report-*.json
reports/session*-dm-guide.pdf
reports/session*-combined.md
reports/session*-combined.html

# Item-card generator output + AI-shortened description cache
reports/item-cards*.pdf
reports/item-cards*.html
scripts/.card-desc-cache.json

# Scratch / scrape working directory — never commit (may contain auth tokens,
# third-party copyrighted content, or other sensitive captures)
tmp/frhof-raw/
tmp/menzo-raw/

# Helm release overrides (may contain passwords)
helm/**/values-local.yaml
helm/**/secrets.yaml

# FoundryVTT runtime (proprietary — never commit)
.foundry/

# Database backups (may contain user data)
.devcontainer/db/backups/

# Block temp files
TO-DO.md
dm-ai-config.md
# Squad: ignore runtime state (logs, inbox, sessions)
.squad/orchestration-log/
.squad/log/
.squad/decisions/inbox/
.squad/sessions/
# Squad: SubSquad activation file (local to this machine)
.squad-workstream
