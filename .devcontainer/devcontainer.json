{
  "name": "KnoxRPG HotD Development",

  // Use docker-compose so PostgreSQL (pgvector) runs alongside the dev container
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/knoxrpg-hotd-website",

  "features": {
    "ghcr.io/devcontainers/features/azure-cli:1": {},
    "ghcr.io/devcontainers/features/docker-in-docker:2": { "moby": false },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

  "forwardPorts": [3000, 3001, 5432, 30000],
  "portsAttributes": {
    "3000": { "label": "HotD Website", "onAutoForward": "notify" },
    "3001": { "label": "HotD Website (dev)", "onAutoForward": "silent" },
    "5432": { "label": "PostgreSQL", "onAutoForward": "silent" },
    "30000": {
      "label": "FoundryVTT",
      "onAutoForward": "notify",
      "visibility": "public"
    }
  },

  // Codespaces Secrets are injected automatically.
  // For local Docker, set these as host environment variables.
  // PG vars + Azure SP vars are set by docker-compose.yml.
  "remoteEnv": {
    "FOUNDRY_USERNAME": "${localEnv:FOUNDRY_USERNAME}",
    "FOUNDRY_PASSWORD": "${localEnv:FOUNDRY_PASSWORD}",
    "FOUNDRY_ADMIN_PASSWORD": "${localEnv:FOUNDRY_ADMIN_PASSWORD}",
    "FOUNDRY_LICENSE_KEY": "${localEnv:FOUNDRY_LICENSE_KEY}",
    "FOUNDRY_BUILD": "${localEnv:FOUNDRY_BUILD}",
    "OPENAI_API_KEY": "${localEnv:OPENAI_API_KEY}",
    "AZURE_TENANT": "${localEnv:AZURE_TENANT}",
    "AZURE_CLIENT_ID": "${localEnv:AZURE_CLIENT_ID}",
    "AZURE_SECRET": "${localEnv:AZURE_SECRET}",
    "AZURE_SUBSCRIPTION_ID": "${localEnv:AZURE_SUBSCRIPTION_ID}"
  },

  "customizations": {
    "vscode": {
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.tabSize": 2,
        "files.trimTrailingWhitespace": true,
        "[markdown]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[json]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        }
      },
      "extensions": [
        // Core JS/Node
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "christian-kohler.npm-intellisense",
        "christian-kohler.path-intellisense",

        // Docker
        "ms-azuretools.vscode-docker",

        // Azure
        "ms-vscode.azure-account",
        "ms-azuretools.vscode-azureresourcegroups",

        // Git
        "eamodio.gitlens",
        "mhutchie.git-graph",
        "github.vscode-pull-request-github",

        // Database (PostgreSQL)
        "ckolkman.vscode-postgres",

        // Markdown & Docs
        "yzhang.markdown-all-in-one",
        "bierner.markdown-preview-github-styles",

        // REST / API testing
        "humao.rest-client",

        // FoundryVTT module dev
        "meganrogge.template-string-converter",
        "formulahendry.auto-rename-tag",

        // General DX
        "streetsidesoftware.code-spell-checker",
        "usernamehw.errorlens",
        "github.copilot",
        "github.copilot-chat"
      ]
    }
  },

  // Install PostgreSQL client tools, Node deps, and make scripts executable
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y postgresql-client && cd src && npm install && cd /workspaces/knoxrpg-hotd-website/.devcontainer && npm install --no-save classic-level && chmod +x scripts/*.sh",

  // Download/install FoundryVTT + start both servers on every container start
  "postStartCommand": "bash .devcontainer/setup-foundry.sh && bash .devcontainer/scripts/start-dev.sh",

  "remoteUser": "node"
}
